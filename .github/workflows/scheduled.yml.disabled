# Rename to scheduled.yml only after controlled cloud/Discord testing and approval.
name: Discord Video Alerts — approved production schedule
on:
  schedule:
    - cron: '7,37 * * * *'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: discord-video-alerts-state
  cancel-in-progress: false
jobs:
  monitor:
    if: vars.DVA_PRODUCTION_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
      - run: 'python -m pip install --only-binary=:all: -r requirements.lock'
      - run: python -m unittest discover -s tests
        env:
          PYTHONPATH: src
      - run: python -m video_alerts.cli monitor --github --live --confirmation SEND
        env:
          PYTHONPATH: src
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
